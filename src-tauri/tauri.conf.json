{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clarify",
  "version": "0.1.0",
  "identifier": "com.clarify.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clarify",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Clarify",
    "copyright": "Clarify",
    "shortDescription": "把生活交给 Clarify，解放你的脑空间",
    "longDescription": "本地优先的 AI 协作待办：全局热键语音捕捉、AI 解析、悬浮窗始终可见。",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
